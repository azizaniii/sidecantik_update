# =========================================================
# SIDECANTIK — Backend .env (contoh untuk production)
# Salin file ini menjadi ".env" lalu isi nilai sebenarnya.
#
#   cp .env.example .env
#   nano .env
#
# JANGAN commit file ".env" ke git (sudah ada di .gitignore).
# =========================================================

# --- Koneksi database ---
# Variabel ini HARUS persis nama ini karena dibaca langsung oleh kode
# (backend-sidecantik-beta), bukan DB_PASSWORD/APP_DB_PASSWORD.
DB_HOST=localhost
DB_NAME=sidecantik
DB_USER=sidecantik_app
DB_PASS=GANTI_DENGAN_PASSWORD_YANG_SAMA_SEPERTI_DI_INIT_SQL

# --- Autentikasi JWT ---
# WAJIB pakai secret baru untuk production, JANGAN pakai ulang secret
# development manapun (termasuk yang pernah muncul di riwayat chat).
# Generate secret baru dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=GANTI_DENGAN_SECRET_BARU_HASIL_GENERATE_DI_ATAS

# --- Port server backend (native, tanpa Docker) ---
PORT=3001
